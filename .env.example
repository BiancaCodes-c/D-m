# Copy this file to .env and fill in secrets.
# Never commit a real .env file.

APP_ENV=development
LOG_LEVEL=INFO

HOST=127.0.0.1
PORT=8000

# Scheduler
SCHED_INTERVAL_MIN=5
# Set to 0 when running a separate worker (docker-compose default)
EMBED_SCHEDULER=1

# Cache / feed
FEED_CACHE_TTL_SECONDS=60

# Primary location: Wilmington, Delaware
DEFAULT_LOCATION_NAME=Wilmington
DEFAULT_LATITUDE=39.7391
DEFAULT_LONGITUDE=-75.5398

# Database
DATABASE_PATH=data/db/dheghom.db

# OpenAQ (required for many v3 endpoints)
OPENAQ_API_KEY=

# Optional
EPA_API_KEY=
